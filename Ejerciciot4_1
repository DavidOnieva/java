import java.util.Scanner;
public class Ejerciciot4_1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Introduce un día de la semana: ");
        String dia = sc.nextLine();
        switch (dia){
            case "lunes":
                System.out.println("Tienes inglés");
                break;
            case "martes":
                System.out.println("Tienes Historia de España");
                break;
            case "miércoles":
                System.out.println("Tienes Tecnología");
                break;
            case "jueves":
                System.out.println("Tienes Matemáticas");
                break;
            case "viernes":
                System.out.println("Tienes Lengua");
                break;
            default:
                System.out.println("No es un día válido o no tienes clase ese día");
        }
        sc.close();
    }
}